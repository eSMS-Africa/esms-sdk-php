{
    "name": "esmsafrica/sms",
    "description": "Official PHP SDK for the eSMS Africa SMS API",
    "type": "library",
    "keywords": ["esms", "esms africa", "sms", "sms api", "bulk sms", "sms gateway", "otp", "verification", "2fa", "messaging", "africa"],
    "homepage": "https://esmsafrica.io",
    "license": "MIT",
    "authors": [
        {
            "name": "eSMS Africa",
            "email": "support@esmsafrica.io"
        }
    ],
    "support": {
        "email": "support@esmsafrica.io",
        "docs": "https://docs.esmsafrica.io/docs/sdks",
        "issues": "https://github.com/eSMS-Africa/esms-sdk-php/issues",
        "source": "https://github.com/eSMS-Africa/esms-sdk-php"
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "Esms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esms\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
